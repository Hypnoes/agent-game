     /// 等到绝对时刻 `deadline`。等价于 `wait`，但避免调用方自己算剩余时间。
     pub async fn wait_until(&self, sub: &mut Subscription, deadline: Instant) -> WaitOutcome {
         let budget = deadline.saturating_duration_since(Instant::now());
         self.wait(sub, budget).await
